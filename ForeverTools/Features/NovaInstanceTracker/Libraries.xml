  <Include file="NovaInstanceTracker/Lib/AceGUI-3.0-SharedMediaWidgets/widget.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceAddon-3.0/AceAddon-3.0.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceConfig-3.0/AceConfig-3.0.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceDB-3.0/AceDB-3.0.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceDBOptions-3.0/AceDBOptions-3.0.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceComm-3.0/Acecomm-3.0.xml"/>
  <Include file="NovaInstanceTracker/Lib/AceSerializer-3.0/AceSerializer-3.0.xml"/>
